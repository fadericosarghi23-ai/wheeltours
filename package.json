{
  "name": "wheel-tours",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nuovo sito Wheel Tours (golf cart tours a Roma). Vite + React + TS, Tailwind v4, struttura shadcn.",
  "scripts": {
    "dev": "vite --port 4810",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4810",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "import:content": "node scripts/import-content.mjs",
    "trace:logo": "node scripts/trace-logo.mjs",
    "gen:netlify": "node scripts/gen-netlify.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "node-html-parser": "^9.0.7",
    "potrace": "^2.1.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
